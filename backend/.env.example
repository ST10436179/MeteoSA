# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

PORT=3000

# Supabase: click "Connect" on your project dashboard -> "Transaction pooler" (NOT "Direct
# connection" - that host is IPv6-only now and won't resolve on most home/mobile networks
# unless you pay for Supabase's IPv4 add-on). The pooler string looks like this, with your
# project ref appearing twice and the port being 6543:
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Any long random string. Used to sign/verify JWTs - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
