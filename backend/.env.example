# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

PORT=3000

# Supabase: Project Settings -> Database -> Connection string -> "URI" (use the pooled
# "Transaction" connection string on port 6543 if deploying to Render's free tier).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Any long random string. Used to sign/verify JWTs - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
