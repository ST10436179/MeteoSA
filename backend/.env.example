# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

PORT=3000

# Supabase: click "Connect" on your project dashboard -> "Transaction pooler" (NOT "Direct
# connection" - that host is IPv6-only now and won't resolve on most home/mobile networks
# unless you pay for Supabase's IPv4 add-on). The pooler string looks like this, with your
# project ref appearing twice and the port being 6543:
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Any long random string. Used to sign/verify JWTs - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# SSO (Part 3): the Web application OAuth client id from Firebase/Google Cloud console
# (google-services.json -> client[0].oauth_client[] entry with client_type 3). Used to verify
# that Google ID tokens sent by the Android app were actually issued for this project.
GOOGLE_WEB_CLIENT_ID=CHANGE_ME_TO_YOUR_WEB_CLIENT_ID

# Push notifications (Part 3): Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. Paste the ENTIRE downloaded JSON file as a single-line string here.
# Without this set, push notifications silently no-op (report submission still works normally).
GOOGLE_SERVICE_ACCOUNT_KEY=CHANGE_ME_TO_YOUR_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=meteosa
