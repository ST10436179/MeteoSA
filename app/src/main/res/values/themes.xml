<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme; the actual Material 3 color scheme is applied in Compose (ui/theme/Theme.kt).
         This XML theme just sets the window background before Compose takes over, avoiding a
         white flash on launch. -->
    <style name="Theme.MeteoSA" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/sa_green</item>
    </style>
</resources>
